# LINE Messaging API (https://developers.line.biz/console/)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# PromptPay receiver: Thai mobile number or 13-digit national/tax ID
PROMPTPAY_ID=

# Public HTTPS URL of this server (used for QR image links)
APP_BASE_URL=https://your-host.example.com

# Optional
OWNER_USER_ID=
